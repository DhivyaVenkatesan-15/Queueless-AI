    flash("Next token is now being served.", "success")
    return redirect(url_for("admin_dashboard"))


@app.route("/complete-token", methods=["POST"])
@admin_required
def complete_token():
    complete_current_token()
    flash("Current token completed.", "success")
    return redirect(url_for("admin_dashboard"))


@app.route("/export-csv")
@admin_required
def export_csv():
    tokens = get_all_tokens()

    output = io.StringIO()
    writer = csv.writer(output)

    writer.writerow([
        "Token Number",
        "Customer Name",
        "Service",
        "Status",
        "Created At"
    ])

    for token in tokens:
        writer.writerow([
            token["token_number"],
            token["customer_name"],
            token["service"],
            token["status"],
            token["created_at"]
        ])

    return Response(
        output.getvalue(),
        mimetype="text/csv",
        headers={
            "Content-Disposition":
            "attachment; filename=queue_report.csv"
        }
    )


@app.route("/api/queue")
@admin_required
def queue_api():
    return jsonify({
        "statistics": get_queue_statistics(),
        "tokens": get_all_tokens()
    })


